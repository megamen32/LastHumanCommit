{
  "classes": {
    "fast": "routine: research, search, reading, polling, waiting, mechanical edits",
    "middle": "code written by a ready plan",
    "frontier": "architecture, hard problems, work that dragged on past its estimate"
  },
  "families": [
    {
      "match": "flash",
      "class": "fast"
    },
    {
      "match": "fast",
      "class": "fast"
    },
    {
      "match": "haiku",
      "class": "fast"
    },
    {
      "match": "fable",
      "class": "frontier"
    },
    {
      "match": "opus",
      "class": "frontier"
    },
    {
      "match": "astra",
      "class": "frontier"
    },
    {
      "match": "sol",
      "class": "frontier"
    },
    {
      "match": "terra",
      "class": "middle"
    },
    {
      "match": "sonnet",
      "class": "middle"
    },
    {
      "match": "glm 5 3",
      "class": "middle"
    },
    {
      "match": "grok 4 7",
      "class": "middle"
    }
  ],
  "examples": {
    "fast": [
      "glm-5.3-flash",
      "minimax-3.1-flash",
      "claude-haiku-5.5",
      "grok-4.7-fast"
    ],
    "middle": [
      "glm-5.3",
      "gpt-6.1-terra",
      "claude-sonnet-5.5",
      "grok-4.7"
    ],
    "frontier": [
      "gpt-6-astra",
      "gpt-6.1-sol",
      "claude-fable-5.2",
      "claude-opus-5.5"
    ]
  },
  "coding_benchmark": {
    "metric": "swebench_pro",
    "manifest_path": "coding-benchmarks.json",
    "manifest_url": "https://megamen32.github.io/models-supplement/coding-benchmarks.json",
    "frontier_anchors": [
      "openai/gpt-6-astra",
      "openai/gpt-6.1-sol",
      "anthropic/claude-fable-5.2",
      "anthropic/claude-opus-5.5"
    ],
    "frontier_families": [
      "astra",
      "sol",
      "fable",
      "opus"
    ],
    "never_frontier_families": [
      "luna"
    ],
    "fast_families": [
      "fast",
      "haiku"
    ],
    "fast_anchors": [
      "glm-5.3-flash",
      "minimax-3.1-flash",
      "grok-4.7-fast",
      "claude-haiku-5.5"
    ]
  }
}
